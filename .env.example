# SynCare Backend: environment template
#
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
#
# LANGFLOW_SECRET_KEY must be a Fernet key: Fernet.generate_key().
# Other secrets can use: openssl rand -hex 32

# Langflow
# Fresh superuser. Do NOT reuse credentials from any previous install.
LANGFLOW_SUPERUSER=frisky
LANGFLOW_SUPERUSER_PASSWORD=

# Encrypts Langflow global Variables (Gemini/Astra credentials).
# If you lose this, stored variables become undecryptable and must be re-entered.
LANGFLOW_SECRET_KEY=

LANGFLOW_PORT=7860

# Console -> Langflow
# API key minted in the Langflow UI (Settings > API keys).
LANGFLOW_API_KEY=

# Langflow's auto-login is deliberately OFF so the human gate stays explicit.
LANGFLOW_AUTO_LOGIN=false

# Console
SYNCARE_HOST=127.0.0.1
SYNCARE_PORT=8080

# Set to 1 to block every mutating endpoint (403). Useful for a read-only demo.
SYNCARE_READ_ONLY=0

# Paths (optional overrides)
# SYNCARE_REVIEW_DB=/home/ubuntu/kittys-workspace/syncare-be/data/syncare-review.sqlite3
# SYNCARE_STATE_DB=/home/ubuntu/kittys-workspace/syncare-be/data/console-state.sqlite3

# Bearer token for the console's own public API
# REQUIRED in production. Every /api/* route demands
#   Authorization: Bearer <this value>
# A MISSING value does not open the API: it locks it (503 auth_not_configured).
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SYNCARE_API_KEY=

