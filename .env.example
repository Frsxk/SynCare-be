# SynCare Backend: environment template
#
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
#
# LANGFLOW_SECRET_KEY must be a Fernet key: Fernet.generate_key().
# Other secrets can use: openssl rand -hex 32
# Linux private envelopes require an explicit absolute path to an existing raw
# 32-byte key owned by the service user, mode exactly 0600 (no special bits).
# The adapter never generates a key or falls back to plaintext. Windows uses DPAPI.
SYNCARE_PRIVATE_KEY_FILE=

# Langflow
# Fresh superuser. Do NOT reuse credentials from any previous install.
LANGFLOW_SUPERUSER=frisky
LANGFLOW_SUPERUSER_PASSWORD=

# Encrypts Langflow global Variables (Gemini/Astra credentials).
# If you lose this, stored variables become undecryptable and must be re-entered.
LANGFLOW_SECRET_KEY=

LANGFLOW_PORT=7860

# Console -> Langflow
# API key minted in the Langflow UI (Settings > API keys).
LANGFLOW_API_KEY=

# Langflow's auto-login is deliberately OFF so the human gate stays explicit.
LANGFLOW_AUTO_LOGIN=false

# Console
SYNCARE_HOST=127.0.0.1
SYNCARE_PORT=8080

# Set to 1 to block patient/domain writes. Session login/logout still function.
SYNCARE_READ_ONLY=0

# Paths (optional overrides)
# SYNCARE_REVIEW_DB=/srv/syncare/data/syncare-review.sqlite3
# SYNCARE_STATE_DB=/srv/syncare/data/console-state.sqlite3

# Server-only operator-health credential. Never use this as a user session.
# Patient/domain routes require an account session from /api/v1/auth/login.
SYNCARE_API_KEY=

# M02: configure absolute operational path before explicit account initialization.
# SYNCARE_STATE_DB=/absolute/path/to/data/syncare-app.sqlite3
SYNCARE_BACKEND_ORIGIN=http://127.0.0.1:8080
SYNCARE_WEB_ORIGIN=http://127.0.0.1:3000
SYNCARE_ALLOW_LOCAL_HTTP=true
# Generate privately with at least 32 random bytes; never commit the value.
SYNCARE_CURSOR_SECRET=

# M04: explicit server-side approved JSON config paths; missing guidance is unavailable.
# Contact is information-only in this demo; no automatic call or tel action.
# SYNCARE_GUIDANCE_CONFIG=/absolute/path/to/config/emergency-guidance.demo.json
# SYNCARE_F2_CONTEXT_CONFIG=/absolute/path/to/config/f2-context.demo.json

