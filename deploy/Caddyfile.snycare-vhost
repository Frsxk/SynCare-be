
syncare.trackover.web.id {
	# Public traffic (129.226.201.207) is NATed to the LAN IP 10.3.8.40. Bind the LAN IP
	# only so Caddy stays off tailscaled's 100.89.55.94:443.
	bind 10.3.8.40

	encode zstd gzip

	# No basic_auth: the Elysia backend uses a bearer token, and stacking Basic Auth
	# would add a browser prompt to every API call. Fail-closed gate: src/auth.ts.

	# SSE (F4 approval events) must not be buffered or the human reviewer
	# receives the whole stream at once instead of live.
	reverse_proxy 127.0.0.1:8080 {
		header_up Host {upstream_hostport}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		flush_interval -1
	}

	# Never let a proxy or upstream error page leak the internal address.
	header {
		-Server
	}
}
