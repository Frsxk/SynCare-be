
syncare.trackover.web.id {
	# Same 1:1 NAT arrangement as hermes.frxskie.me: public traffic
	# (129.226.201.207) is NATed to the LAN IP 10.3.8.40. Binding only the LAN
	# IP keeps Caddy off tailscaled's tailnet 100.89.55.94:443.
	bind 10.3.8.40

	encode zstd gzip

	# NO basic_auth here, by explicit operator decision: the Elysia backend
	# authenticates with a bearer token, and stacking Basic Auth on top would
	# add a browser credential prompt for every API call the frontend makes.
	# The API gate is fail-closed (see src/auth.ts). This backend serves ONLY
	# /api/* routes and answers everything else with 404; the frontend is a
	# separate application and is served elsewhere.

	# SSE (F4 approval events) must not be buffered or the human reviewer
	# receives the whole stream at once instead of live.
	reverse_proxy 127.0.0.1:8080 {
		header_up Host {upstream_hostport}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		flush_interval -1
	}

	# Never let a proxy or upstream error page leak the internal address.
	header {
		-Server
	}
}
